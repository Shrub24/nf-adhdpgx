// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core subworkflows test preprocessing
nextflow_workflow {

    name "Test Subworkflow PREPROCESSING"
    script "../main.nf"
    workflow "PREPROCESSING"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/preprocessing"
    tag "gatk4"
    tag "gatk4/markduplicates"
    tag "gatk4/baserecalibrator"
    tag "gatk4/applybqsr"

    test("human - paired_end_bam - bqsr_enabled") {
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_sample', single_end:false, sex:'XX' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ])
                input[1] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ])
                input[2] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ])
                input[3] = true // enable_bqsr
                input[4] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true) ])
                input[5] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true) ])
                input[6] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true) ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.out.bam.size() == 1 },
                { assert workflow.out.bam[0][0].id == 'test_sample' },
                { assert workflow.out.bam[0][1].toString().endsWith('.bam') },
                { assert workflow.out.bam[0][2].toString().endsWith('.bai') },
                { assert workflow.out.metrics.size() == 1 },
                { assert workflow.out.versions }
            )
        }
    }

    test("human - paired_end_bam - bqsr_disabled") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_no_bqsr', single_end:false, sex:'XY' ],
                    file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ])
                input[1] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ])
                input[2] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ])
                input[3] = false // enable_bqsr
                input[4] = Channel.empty()
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.out.bam.size() == 1 },
                { assert workflow.out.bam[0][0].id == 'test_no_bqsr' },
                { assert workflow.out.bam[0][1].toString().endsWith('.bam') },
                { assert workflow.out.bam[0][2].toString().endsWith('.bai') },
                { assert workflow.out.metrics.size() == 1 }
            )
        }
    }

    test("human - multiple_samples - bqsr_enabled") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ [ id:'sample1', single_end:false, sex:'XX' ], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ],
                    [ [ id:'sample2', single_end:false, sex:'XY' ], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam', checkIfExists: true) ]
                )
                input[1] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ])
                input[2] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ])
                input[3] = true // enable_bqsr
                input[4] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true) ])
                input[5] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true) ])
                input[6] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true) ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam.size() == 2 },
                { assert workflow.out.bam.collect { it[0].id }.containsAll(['sample1', 'sample2']) },
                { assert workflow.out.bam.every { it[1].toString().endsWith('.bam') } },
                { assert workflow.out.bam.every { it[2].toString().endsWith('.bai') } },
                { assert workflow.out.metrics.size() == 2 }
            )
        }
    }

        test("human - multiple_samples - bqsr_disabled") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [ [ id:'sample1', single_end:false, sex:'XX' ], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ],
                    [ [ id:'sample2', single_end:false, sex:'XY' ], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/illumina/bam/test2.paired_end.sorted.bam', checkIfExists: true) ]
                )
                input[1] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ])
                input[2] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ])
                input[3] = false // enable_bqsr
                input[4] = Channel.empty()
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam.size() == 2 },
                { assert workflow.out.bam.collect { it[0].id }.containsAll(['sample1', 'sample2']) },
                { assert workflow.out.bam.every { it[1].toString().endsWith('.bam') } },
                { assert workflow.out.bam.every { it[2].toString().endsWith('.bai') } },
                { assert workflow.out.metrics.size() == 2 }
            )
        }
    }

    test("human - empty_bam - should_fail") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'empty_bam', single_end:false, sex:'XX' ],
                    []
                ])
                input[1] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ])
                input[2] = Channel.value([ [ref: true], file(params.modules_testdata_base_path + '/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ])
                input[3] = false // enable_bqsr
                input[4] = Channel.empty()
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed }
            )
        }
    }
}
