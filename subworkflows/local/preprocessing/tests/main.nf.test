// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core subworkflows test preprocessing
nextflow_workflow {

    name "Test Subworkflow PREPROCESSING"
    script "../main.nf"
    workflow "PREPROCESSING"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/preprocessing"
    tag "gatk4"
    tag "gatk4/markduplicates"
    tag "gatk4/baserecalibrator"
    tag "gatk4/applybqsr"

    test("human - paired_end_bam - bqsr_enabled") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test_sample', single_end:false, sex:'XX' ], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                input[2] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                input[3] = true // enable_bqsr
                input[4] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                input[5] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true)
                input[6] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.out.bam_bai.size() == 1 },
                { assert workflow.out.bam_bai[0][0].id == 'test_sample' },
                { assert workflow.out.bam_bai[0][1].toString().endsWith('.bam') },
                { assert workflow.out.bam_bai[0][2].toString().endsWith('.bai') },
                { assert workflow.out.versions }
            )
        }
    }

    test("human - paired_end_bam - bqsr_disabled") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test_no_bqsr', single_end:false, sex:'XY' ], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                input[2] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                input[3] = false // enable_bqsr
                input[4] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                input[5] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true)
                input[6] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.out.bam_bai.size() == 1 },
                { assert workflow.out.bam_bai[0][0].id == 'test_no_bqsr' },
                { assert workflow.out.bam_bai[0][1].toString().endsWith('.bam') },
                { assert workflow.out.bam_bai[0][2].toString().endsWith('.bai') }
            )
        }
    }

    test("human - multiple_samples - bqsr_enabled") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'sample1', single_end:false, sex:'XX' ],
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ],
                    [
                        [ id:'sample2', single_end:false, sex:'XY' ],
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                )
                input[1] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                input[2] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                input[3] = true // enable_bqsr
                input[4] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                input[5] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true)
                input[6] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam_bai.size() == 2 },
                { assert workflow.out.bam_bai.collect { it[0].id }.containsAll(['sample1', 'sample2']) },
                { assert workflow.out.bam_bai.every { it[1].toString().endsWith('.bam') } },
                { assert workflow.out.bam_bai.every { it[2].toString().endsWith('.bai') } }
            )
        }
    }

    test("human - empty_bam - should_fail") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'empty_bam', single_end:false, sex:'XX' ],
                    [],
                    []
                ]
                input[1] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                input[2] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                input[3] = false // enable_bqsr
                input[4] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                input[5] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz', checkIfExists: true)
                input[6] = file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed }
            )
        }
    }
}
